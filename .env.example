# =============================================================================
# Story-Based Learning AI - Environment Configuration
# Konfigurasi Lingkungan AI Pembelajaran Berbasis Cerita
# =============================================================================
# Copy this file to .env and modify as needed
# Salin file ini ke .env dan sesuaikan sesuai kebutuhan

# =============================================================================
# LLM PROVIDER - Pilih Provider LLM
# =============================================================================
# Pilihan: google_vertexai | google_genai | openai | openrouter | deepseek | glm | ollama
LLM_PROVIDER=google_vertexai

# Model yang digunakan (kosongkan untuk menggunakan default provider)
LLM_MODEL=

# =============================================================================
# GOOGLE VERTEX AI (LLM_PROVIDER=google_vertexai)
# Membutuhkan credential.json di root proyek
# =============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# GOOGLE GENERATIVE AI API (LLM_PROVIDER=google_genai)
# Tanpa credential.json - cukup API key
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# DEEPSEEK (LLM_PROVIDER=deepseek)
# =============================================================================
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1   # default, uncomment to override

# =============================================================================
# GLM / ZHIPU AI (LLM_PROVIDER=glm)
# =============================================================================
GLM_API_KEY=your-zhipuai-api-key
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   # default, uncomment to override

# =============================================================================
# OPENAI (LLM_PROVIDER=openai)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key

# =============================================================================
# OPENROUTER (LLM_PROVIDER=openrouter)
# Akses 200+ model (OpenAI, Anthropic, Google, Meta, dll.) via satu API key
# Daftar model: https://openrouter.ai/models
# =============================================================================
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
# LLM_MODEL=openai/gpt-4o-mini        # default
# LLM_MODEL=anthropic/claude-3-haiku
# LLM_MODEL=google/gemini-flash-1.5
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default
# OPENROUTER_SITE_URL=https://your-site.com          # opsional, untuk ranking
# OPENROUTER_APP_NAME=Story-Based Learning AI        # opsional, untuk ranking

# =============================================================================
# OLLAMA / LLM LOKAL (LLM_PROVIDER=ollama)
# =============================================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1   # default, uncomment to override
# LLM_MODEL=llama3.2

# =============================================================================
# KONFIGURASI LAMA (backward-compat, masih dibaca jika LLM_MODEL tidak diset)
# =============================================================================
GEMINI_MODEL=gemini-2.5-flash
PROJECT_ID=your-project-id

# Temperature per agent (0.0 = deterministic, 1.0 = creative)
PARSER_TEMPERATURE=0.3
RESEARCHER_TEMPERATURE=0.5
PLANNER_TEMPERATURE=0.7
WRITER_TEMPERATURE=0.8
CRITIC_TEMPERATURE=0.2

# =============================================================================
# STORY GENERATION - Pengaturan Pembuatan Cerita
# =============================================================================

# Maximum number of revision iterations
MAX_REVISIONS=7

# Quality threshold to pass (0-10)
QUALITY_THRESHOLD=4.0

# Coherence penalty weight per issue
COHERENCE_PENALTY_WEIGHT=1.0

# Default values for story generation
DEFAULT_LANGUAGE=Indonesian
DEFAULT_STORY_LENGTH=medium
DEFAULT_TARGET_AGE=8-10
DEFAULT_STORY_STYLE=naratif
DEFAULT_EMOTIONAL_TONE=mengangkat semangat

# Story length descriptions
STORY_LENGTH_SHORT=1-2 halaman (sekitar 300-500 kata)
STORY_LENGTH_MEDIUM=3-5 halaman (sekitar 800-1500 kata)
STORY_LENGTH_LONG=6+ halaman (sekitar 2000-3000 kata)

# =============================================================================
# SCORE FRAMEWORK - Framework Koherensi Naratif
# =============================================================================

# Enable SCORE framework
SCORE_ENABLED=true

# SCORE storage directory
SCORE_STORAGE_PATH=./score_storage

# Maximum states per episode
MAX_STATES_PER_EPISODE=50

# =============================================================================
# LIGHTRAG - Knowledge Graph RAG
# =============================================================================

# LightRAG Server API URL
LIGHTRAG_API_URL=http://localhost:9621

# Optional API Key for LightRAG
LIGHTRAG_API_KEY=

# Ingestion settings
LIGHTRAG_WORKING_DIR=./lightrag_storage
LIGHTRAG_SELECTIVE_INGESTION=true
LIGHTRAG_INGEST_MIN_LENGTH=500
CHUNK_SIZE=1200
CHUNK_OVERLAP=100

# =============================================================================
# SECURITY - Keamanan API
# =============================================================================

# API Key for frontend-backend authentication
API_KEY=your-secure-api-key-here

# Allowed CORS origins (comma-separated, e.g., https://your-app.vercel.app)
ALLOWED_ORIGINS=*

# =============================================================================
# GRADIO UI - Interface Settings
# =============================================================================

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=6723

# App display
APP_TITLE=AI Pembelajaran Berbasis Cerita
APP_DESCRIPTION=Buat cerita edukatif melalui percakapan

# Chatbot settings
CHATBOT_HEIGHT=500

# Font sizes (pixels)
FONT_SIZE_BASE=18
FONT_SIZE_HEADER=20

# Streaming performance
STREAM_YIELD_INTERVAL=0.1

# =============================================================================
# OBSERVABILITY - Logging & Monitoring
# =============================================================================

# Debug mode (shows extra logs)
DEBUG_MODE=false
VERBOSE_LOGGING=false

# Langfuse (optional observability platform)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

